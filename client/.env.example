# TechScroll AI — Frontend Environment Variables
# Copy this to .env.local for local overrides
# In production (Vercel), set these in the Vercel dashboard

# Backend URL — leave empty for local dev (Vite proxy handles it)
# In production, set to your deployed backend URL (no trailing slash)
# Example: VITE_API_URL=https://techscroll-api.onrender.com
VITE_API_URL=
